# Настройки конкретного проекта. Их место — в корне ПРОЕКТА, рядом с claude-kit/,
# а не здесь. Строка стоит на случай, если файл положат сюда по старой памяти:
# кит общий, и заполненный project.conf в нём — это чужие номера чата и тем,
# уехавшие в репозиторий инструмента.
project.conf

# Рабочее состояние моста: offset приёмника, указатели на сокет и имя оркестратора.
# С этой версии оно живёт в <проект>/.kit-state/, но старые копии кита держали его
# внутри — обе формы игнорируются, чтобы состояние не попало в общий репозиторий
# ни при каком порядке переноса.
.kit-state/
tg/state/

# Служебное
__pycache__/
*.py[cod]
.DS_Store
