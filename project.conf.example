# Шаблон настроек проекта. Скопировать в КОРЕНЬ ПРОЕКТА и заполнить.
#
#   cp claude-kit/project.conf.example project.conf
#
# Место важно: файл лежит рядом с claude-kit/, а НЕ внутри него. Кит подключается
# git-подмодулем и общий для всех проектов; настройки, оставленные внутри него,
# при обновлении подмодуля затрутся или уедут в чужой проект. Скрипты ищут этот
# файл вверх от каталога кита и внутрь кита не заглядывают.
#
# Это единственный файл, который нужно править, чтобы кит заработал на новом
# проекте. Если понадобилось поменять что-то ещё — значит в ките осталась
# привязка к проекту, и её надо вынести сюда.
#
# Рабочее состояние (offset приёмника, указатели оркестратора) сюда не пишется:
# оно живёт в каталоге .kit-state/ рядом с этим файлом и в git не попадает.
#
# Порядок действий целиком — в claude-kit/SETUP.md.
#
# Формат ограничен, чтобы одинаково разбираться и bash, и Python:
#   KEY=значение | KEY="значение" | KEY='значение'
#   строки на «#» и пустые — комментарии
#   подстановки ($VAR, `cmd`, $(cmd)) ЗАПРЕЩЕНЫ — bash их раскроет, Python нет.
#
# Скрипты отказываются работать, пока в значении остаётся <плейсхолдер>,
# и говорят, какой именно ключ не заполнен.

# ── Проект ─────────────────────────────────────────────────────────────────────

# Человеческое название проекта. Попадает в сообщения и в сводки.
PROJECT_NAME="<название проекта>"

# Имя сессии-оркестратора: адрес для SendMessage и то, что делегированные сессии
# видят как единственного собеседника.
#
# Должно совпадать с --name, под которым запущена главная сессия, и быть
# уникальным на машине: если два проекта назовут оркестратора одинаково,
# SendMessage перестанет их различать. Поэтому имя вида «<проект>-orchestrator»
# надёжнее общего «orchestrator».
ORCHESTRATOR_NAME="<проект>-orchestrator"

# ── Telegram ───────────────────────────────────────────────────────────────────

# Идентификатор супергруппы с включёнными темами — со знаком минус
# и префиксом -100, например «-1001234567890».
#
# Где взять: добавить бота в группу, написать туда что угодно и выполнить
#   curl -s "https://api.telegram.org/bot<ТОКЕН>/getUpdates" | python3 -m json.tool
# в ответе взять message.chat.id.
TG_CHAT_ID="<-100…>"

# Имя записи в macOS Keychain, где лежит токен бота. Сам токен здесь
# не хранится и в репозиторий не попадает никогда.
#
# Имя должно быть уникальным на машине — у каждого проекта свой бот и свой
# токен, общее имя вида «telegram-bot-token» приведёт к тому, что второй
# проект перезапишет ключ первого. Положить токен:
#   security add-generic-password -a "$USER" -s <имя> -w '<ТОКЕН>' -U
TG_KEYCHAIN_SERVICE="telegram-bot-token-<проект>"

# ── Темы группы ────────────────────────────────────────────────────────────────
#
# TG_TOPIC_* — идентификатор темы, TG_RULES_* — идентификатор первого сообщения
# в ней, где лежат правила темы. Правила правятся на месте (tg-edit.sh), поэтому
# их номера нужны постоянно; заводить вместо правки новое сообщение нельзя.
#
# Где взять номера: создать темы руками, написать в каждую по сообщению
# и посмотреть dialog/TOPICS.md — приёмник заполняет его сам. Номер сообщения
# с правилами печатает tg-send.sh при отправке.
#
# Назначение тем менять не стоит: на это разделение опирается ORCHESTRATOR.md.

TG_TOPIC_TASKS="<id>"        # Постановка задач — задачи от владельца, живут реакции
TG_RULES_TASKS="<id>"

TG_TOPIC_REPORTS="<id>"      # Отчёты — итоги закрытых задач
TG_RULES_REPORTS="<id>"

TG_TOPIC_QUESTIONS="<id>"    # Вопросы — только NeedsOwner
TG_RULES_QUESTIONS="<id>"

TG_TOPIC_IMPORTANT="<id>"    # Важное — ссылки и постоянные сведения
TG_RULES_IMPORTANT="<id>"

TG_TOPIC_ORCH="<id>"         # Оркестратор — разговор вне задач
TG_RULES_ORCH="<id>"
